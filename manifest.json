{
  "manifest_version": 3,
  "name": "ChatGPT 右侧问题导航",
  "short_name": "ChatGPT 右侧导航",
  "version": "1.0.3",
  "description": "复刻 ChatGPT 经典右侧小横线导航。悬停预览问题，点击跳转至当前网页已加载的问题。不访问网络、不主动加载历史记录。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["scripting"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "重新加载 ChatGPT 右侧问题导航"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
