{
  "manifest_version": 3,
  "name": "ChatGPT 右侧问题导航",
  "short_name": "ChatGPT 右侧导航",
  "version": "2.2.1",
  "description": "ChatGPT 问题导航：复用网页历史加载器补全目录，保留阅读位置；支持问题与回答预览、本地书签、键盘和拖动定位。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["scripting", "storage"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "重新加载 ChatGPT 右侧问题导航"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["conversation-model.js", "history-loader.js", "page-state.js", "page-bridge.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["conversation-model.js", "content.js"],
      "world": "ISOLATED",
      "run_at": "document_idle"
    }
  ]
}
